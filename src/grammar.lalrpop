// ── Gramática libre de contexto del lenguaje Patito ──────────────────────────
// Todas las reglas devuelven () — solo se valida la sintaxis.

use crate::lexer::{Token, LexError};

grammar;

// ── Declaración del lexer externo (logos)
extern {
    type Location = usize;
    type Error = LexError;

    enum Token {
        "programa" => Token::Programa,
        "inicio"   => Token::Inicio,
        "fin"      => Token::Fin,
        "vars"     => Token::Vars,
        "entero"   => Token::Entero,
        "flotante" => Token::Flotante,
        "nula"     => Token::Nula,
        "si"       => Token::Si,
        "sino"     => Token::Sino,
        "mientras" => Token::Mientras,
        "haz"      => Token::Haz,
        "escribe"  => Token::Escribe,
        "regresa"  => Token::Regresa,
        "id"       => Token::Id(<String>),
        "cte_ent"  => Token::CteEnt(<i64>),
        "cte_flot" => Token::CteFlot(<f64>),
        "letrero"  => Token::Letrero(<String>),
        "=="       => Token::Igual,
        "!="       => Token::Dif,
        "="        => Token::Asig,
        "<"        => Token::Menor,
        ">"        => Token::Mayor,
        "+"        => Token::Mas,
        "-"        => Token::Menos,
        "*"        => Token::Por,
        "/"        => Token::Div,
        "("        => Token::LParen,
        ")"        => Token::RParen,
        "{"        => Token::LlaveIzq,
        "}"        => Token::LlaveDer,
        "["        => Token::CorcIzq,
        "]"        => Token::CorcDer,
        ":"        => Token::DosPuntos,
        ";"        => Token::PuntoComa,
        ","        => Token::Coma,
    }
}

// ── §4.1  Programa ────────────────────────────────────────────────────────────
// <Programa> → programa id ; <VARS_OPT> <FUNCS_LIST> inicio <CUERPO> fin
pub Programa: () = {
    "programa" "id" ";" VarsOpt FuncsList "inicio" Cuerpo "fin" => ()
};

// ── §4.2  Variables (bloque opcional) ────────────────────────────────────────
// <VARS_OPT> → <VARS> | ε
VarsOpt: () = {
    Vars => (),
         => (),   // ε: no hay bloque vars
};

// <VARS> → vars <LISTA_DEC>
Vars: () = {
    "vars" ListaDec => ()
};

// <LISTA_DEC> → <DEC> <COLA_DEC>
ListaDec: () = {
    Dec ColaDec => ()
};

// <COLA_DEC> → <DEC> <COLA_DEC> | ε
ColaDec: () = {
    Dec ColaDec => (),
                => (),
};

// <DEC> → <LISTA_IDS> : <TIPO> ;
Dec: () = {
    ListaIds ":" Tipo ";" => ()
};

// <LISTA_IDS> → id <COLA_IDS>
ListaIds: () = {
    "id" ColaIds => ()
};

// <COLA_IDS> → , id <COLA_IDS> | ε
ColaIds: () = {
    "," "id" ColaIds => (),
                     => (),
};

// ── §4.3  Tipos ───────────────────────────────────────────────────────────────
// <TIPO> → entero | flotante
Tipo: () = {
    "entero"   => (),
    "flotante" => (),
};

// <TIPO_O_NULO> → <TIPO> | nula
TipoONulo: () = {
    Tipo   => (),
    "nula" => (),
};

// ── §4.4  Funciones ───────────────────────────────────────────────────────────
// <FUNCS_LIST> → <FUNCS> <FUNCS_LIST> | ε
FuncsList: () = {
    Funcs FuncsList => (),
                    => (),
};

// <FUNCS> → <TIPO_O_NULO> id ( <ARGUMENT_LIST> ) { <VARS_OPT> <CUERPO> } ;
// Nota: la llave { aquí es la del encabezado de función; la llave del CUERPO
// es un segundo par de llaves (ver ejemplos del documento).
Funcs: () = {
    TipoONulo "id" "(" ArgumentList ")" "{" VarsOpt Cuerpo "}" ";" => ()
};

// <ARGUMENT_LIST> → <ARGUMENT> <COLA_ARGUMENTS> | ε
ArgumentList: () = {
    Argument ColaArguments => (),
                           => (),
};

// <COLA_ARGUMENTS> → , <ARGUMENT> <COLA_ARGUMENTS> | ε
ColaArguments: () = {
    "," Argument ColaArguments => (),
                               => (),
};

// <ARGUMENT> → id : <TIPO>
Argument: () = {
    "id" ":" Tipo => ()
};

// ── §4.5  Cuerpo y lista de estatutos ─────────────────────────────────────────
// <CUERPO> → { <ESTATUTO_LIST> }
Cuerpo: () = {
    "{" EstatutoList "}" => ()
};

// <ESTATUTO_LIST> → <ESTATUTO> <COLA_ESTATUTOS> | ε
EstatutoList: () = {
    Estatuto ColaEstatutos => (),
                           => (),
};

// <COLA_ESTATUTOS> → <ESTATUTO> <COLA_ESTATUTOS> | ε
ColaEstatutos: () = {
    Estatuto ColaEstatutos => (),
                           => (),
};

// ── §4.6  Estatutos ───────────────────────────────────────────────────────────
// Se factorizó para que cada alternativa empiece con un token distinto (LL(1)):
//   id        → asignación o llamada a función
//   si        → condicional
//   mientras  → ciclo
//   escribe   → impresión
//   regresa   → retorno
//   [         → bloque de estatutos entre corchetes
Estatuto: () = {
    "id" ColaIdEst       => (),
    Condicion            => (),
    Ciclo                => (),
    Imprime              => (),
    Regresa              => (),
    "[" EstatutoList "]" => (),   // bloque entre corchetes
};

// Después de un id en un estatuto: asignación o llamada
// <COLA_ID_EST> → <COLA_ASIGNA> | <COLA_LLAMADA> ;
ColaIdEst: () = {
    ColaAsigna      => (),   // empieza con =
    ColaLlamada ";" => (),   // empieza con (
};

// ── §4.7  Asignación ──────────────────────────────────────────────────────────
// <COLA_ASIGNA> → = <EXPRESION> ;
ColaAsigna: () = {
    "=" Expresion ";" => ()
};

// ── §4.8  Llamada a función ───────────────────────────────────────────────────
// <COLA_LLAMADA> → ( <EXPRESION_LIST> )
ColaLlamada: () = {
    "(" ExpresionList ")" => ()
};

// <EXPRESION_LIST> → <EXPRESION> <COLA_EXPRESION> | ε
ExpresionList: () = {
    Expresion ColaExpresion => (),
                            => (),
};

// <COLA_EXPRESION> → , <EXPRESION> <COLA_EXPRESION> | ε
ColaExpresion: () = {
    "," Expresion ColaExpresion => (),
                                => (),
};

// ── §4.9  Condicional ─────────────────────────────────────────────────────────
// <CONDICION> → si ( <EXPRESION> ) <CUERPO> <SINO_OPC> ;
Condicion: () = {
    "si" "(" Expresion ")" Cuerpo SinoOpc ";" => ()
};

// <SINO_OPC> → sino <CUERPO> | ε
SinoOpc: () = {
    "sino" Cuerpo => (),
                  => (),
};

// ── §4.10  Ciclo ──────────────────────────────────────────────────────────────
// <CICLO> → mientras ( <EXPRESION> ) haz <CUERPO> ;
Ciclo: () = {
    "mientras" "(" Expresion ")" "haz" Cuerpo ";" => ()
};

// ── §4.11  Impresión ──────────────────────────────────────────────────────────
// <IMPRIME> → escribe ( <ELEM_IMPRIME> <COLA_IMPRIME> ) ;
Imprime: () = {
    "escribe" "(" ElemImprime ColaImprime ")" ";" => ()
};

// <ELEM_IMPRIME> → <EXPRESION> | letrero
// "letrero" (cadena literal) no puede empezar una expresión, así que
// el parser distingue ambas alternativas con 1 token de lookahead.
ElemImprime: () = {
    Expresion  => (),
    "letrero"  => (),
};

// <COLA_IMPRIME> → , <ELEM_IMPRIME> <COLA_IMPRIME> | ε
ColaImprime: () = {
    "," ElemImprime ColaImprime => (),
                                => (),
};

// ── §4.12  Regresa ────────────────────────────────────────────────────────────
// <REGRESA> → regresa ( <EXPRESION> ) ;
Regresa: () = {
    "regresa" "(" Expresion ")" ";" => ()
};

// ── §4.13  Expresiones ────────────────────────────────────────────────────────
// Jerarquía: EXPRESION > EXP > TERMINO > FACTOR
// Se usa recursión por la derecha (COLA_*) para evitar recursión por la izquierda.

// <EXPRESION> → <EXP> <COLA_EXPRESION_REL>
Expresion: () = {
    Exp ColaExpresionRel => ()
};

// <COLA_EXPRESION_REL> → <OP_LOGICO> <EXP> | ε
// Solo un operador relacional por expresión (no hay encadenamiento).
ColaExpresionRel: () = {
    OpLogico Exp => (),
                 => (),
};

// <OP_LOGICO> → > | < | != | ==
OpLogico: () = {
    ">"  => (),
    "<"  => (),
    "!=" => (),
    "==" => (),
};

// <EXP> → <TERMINO> <TERMINO_ADD>
Exp: () = {
    Termino TerminoAdd => ()
};

// <TERMINO_ADD> → <OP_ADD> <TERMINO> <TERMINO_ADD> | ε
TerminoAdd: () = {
    OpAdd Termino TerminoAdd => (),
                             => (),
};

// <OP_ADD> → + | -
OpAdd: () = {
    "+" => (),
    "-" => (),
};

// <TERMINO> → <FACTOR> <FACTOR_MULT>
Termino: () = {
    Factor FactorMult => ()
};

// <FACTOR_MULT> → <OP_MULT> <FACTOR> <FACTOR_MULT> | ε
FactorMult: () = {
    OpMult Factor FactorMult => (),
                             => (),
};

// <OP_MULT> → * | /
OpMult: () = {
    "*" => (),
    "/" => (),
};

// ── §4.14  Factor ─────────────────────────────────────────────────────────────
// <FACTOR> → ( <EXPRESION> )
//           | <OP_ADD> <ID_O_CTE>        ← unario + / -
//           | id <COLA_ID_FACTOR>        ← variable o llamada
//           | <CTE>
Factor: () = {
    "(" Expresion ")"  => (),
    OpAdd IdOCte       => (),
    "id" ColaIdFactor  => (),
    Cte                => (),
};

// <ID_O_CTE> → id | <CTE>
IdOCte: () = {
    "id" => (),
    Cte  => (),
};

// <COLA_ID_FACTOR> → <COLA_LLAMADA> | ε
// Si después del id viene '(' es una llamada; en caso contrario, solo variable.
ColaIdFactor: () = {
    ColaLlamada => (),
                => (),
};

// ── §4.15  Constantes ─────────────────────────────────────────────────────────
// <CTE> → cte_ent | cte_flot
Cte: () = {
    "cte_ent"  => (),
    "cte_flot" => (),
};
