// ── Gramática libre de contexto del lenguaje Patito — Entrega 3 ──────────────
//
// Cambios respecto a Entrega 2:
//   · Se separan AsignStmt y CallStmt en el nivel de Estatuto (LALR(1) lo
//     resuelve por lookahead: id "=" → AsignStmt, id "(" → CallStmt).
//   · Se añaden puntos neurálgicos para la generación de cuádruplos en:
//       - operadores binarios y de asignación
//       - paréntesis de agrupación (fondo falso)
//       - constantes e identificadores como operandos
//       - escribe, regresa, si/sino, mientras
//   · Tipo y TipoONulo retornan Type; ListaIds y Argument* retornan tuplas.

use crate::lexer::{Token, LexError};
use crate::types::Type;
use crate::context::SemanticContext;
use crate::semantic_cube::Op;

grammar(ctx: &mut SemanticContext);

// ── Lexer externo (logos) ─────────────────────────────────────────────────────
extern {
    type Location = usize;
    type Error = LexError;

    enum Token {
        "programa" => Token::Programa,
        "inicio"   => Token::Inicio,
        "fin"      => Token::Fin,
        "vars"     => Token::Vars,
        "entero"   => Token::Entero,
        "flotante" => Token::Flotante,
        "nula"     => Token::Nula,
        "si"       => Token::Si,
        "sino"     => Token::Sino,
        "mientras" => Token::Mientras,
        "haz"      => Token::Haz,
        "escribe"  => Token::Escribe,
        "regresa"  => Token::Regresa,
        "id"       => Token::Id(<String>),
        "cte_ent"  => Token::CteEnt(<i64>),
        "cte_flot" => Token::CteFlot(<f64>),
        "letrero"  => Token::Letrero(<String>),
        "=="       => Token::Igual,
        "!="       => Token::Dif,
        "="        => Token::Asig,
        "<"        => Token::Menor,
        ">"        => Token::Mayor,
        "+"        => Token::Mas,
        "-"        => Token::Menos,
        "*"        => Token::Por,
        "/"        => Token::Div,
        "("        => Token::LParen,
        ")"        => Token::RParen,
        "{"        => Token::LlaveIzq,
        "}"        => Token::LlaveDer,
        "["        => Token::CorcIzq,
        "]"        => Token::CorcDer,
        ":"        => Token::DosPuntos,
        ";"        => Token::PuntoComa,
        ","        => Token::Coma,
    }
}

// ── §4.1  Programa ────────────────────────────────────────────────────────────

ProgramaHead: () = {
    "programa" <name:"id"> ";" => { ctx.start_program(name); }
};

pub Programa: () = {
    ProgramaHead VarsOpt FuncsList MainStart "inicio" Cuerpo "fin" => ()
};

// PN — entre la lista de funciones y el bloque 'inicio'. Rellena el GOTO
// inicial (emitido en ProgramaHead) con la posición actual.
MainStart: () = {
    => { ctx.patch_main_goto(); }
};

// ── §4.2  Variables (bloque opcional) ────────────────────────────────────────

VarsOpt: () = {
    Vars => (),
         => (),
};

Vars: () = {
    "vars" ListaDec => ()
};

ListaDec: () = {
    Dec ColaDec => ()
};

ColaDec: () = {
    Dec ColaDec => (),
                => (),
};

Dec: () = {
    <ids:ListaIds> ":" <t:Tipo> ";" => {
        for id in ids {
            ctx.declare_var(id, t);
        }
    }
};

ListaIds: Vec<String> = {
    <id:"id"> <rest:ColaIds> => {
        let mut v = vec![id];
        v.extend(rest);
        v
    }
};

ColaIds: Vec<String> = {
    "," <id:"id"> <rest:ColaIds> => {
        let mut v = vec![id];
        v.extend(rest);
        v
    },
    => vec![],
};

// ── §4.3  Tipos ───────────────────────────────────────────────────────────────

Tipo: Type = {
    "entero"   => Type::Entero,
    "flotante" => Type::Flotante,
};

TipoONulo: Type = {
    <t:Tipo> => t,
    "nula"   => Type::Nula,
};

// ── §4.4  Funciones ───────────────────────────────────────────────────────────

FuncBegin: () = {
    <rt:TipoONulo> <name:"id"> "(" <params:ArgumentList> ")" => {
        ctx.begin_func(name, rt, params);
    }
};

FuncsList: () = {
    Funcs FuncsList => (),
                    => (),
};

Funcs: () = {
    FuncBegin "{" VarsOpt Cuerpo "}" ";" => {
        ctx.gen_endfunc();
        ctx.end_func();
    }
};

ArgumentList: Vec<(String, Type)> = {
    <a:Argument> <rest:ColaArguments> => {
        let mut v = vec![a];
        v.extend(rest);
        v
    },
    => vec![],
};

ColaArguments: Vec<(String, Type)> = {
    "," <a:Argument> <rest:ColaArguments> => {
        let mut v = vec![a];
        v.extend(rest);
        v
    },
    => vec![],
};

Argument: (String, Type) = {
    <id:"id"> ":" <t:Tipo> => (id, t)
};

// ── §4.5  Cuerpo y lista de estatutos ─────────────────────────────────────────

Cuerpo: () = {
    "{" EstatutoList "}" => ()
};

EstatutoList: () = {
    Estatuto ColaEstatutos => (),
                           => (),
};

ColaEstatutos: () = {
    Estatuto ColaEstatutos => (),
                           => (),
};

// ── §4.6  Estatutos ───────────────────────────────────────────────────────────
//
// Asignación y llamada se separan al nivel del Estatuto. El parser LALR(1)
// usa el lookahead (= vs ( ) para decidir cuál producción reducir.

Estatuto: () = {
    AsignStmt            => (),
    CallStmt             => (),
    Condicion            => (),
    Ciclo                => (),
    Imprime              => (),
    Regresa              => (),
    "[" EstatutoList "]" => (),
};

// ── §4.7  Asignación ──────────────────────────────────────────────────────────
//
// Tres puntos neurálgicos:
//   AsignLhs : empuja el id como operando (con su tipo resuelto)
//   AsignEq  : empuja el operador '=' (precedencia 1, queda en el fondo)
//   AsignStmt al ';' : force_collapse del Asig, emite el cuádruplo

AsignStmt: () = {
    AsignLhs AsignEq Expresion ";" => { ctx.end_assignment(); }
};

AsignLhs: () = {
    <id:"id"> => { ctx.push_id_operand(id); }
};

AsignEq: () = {
    "=" => { ctx.push_operator(Op::Asig); }
};

// ── §4.8  Llamada a función ──────────────────────────────────────────────────
//
// Entrega 4 Parte 2:
//   CallStmtHead reduce el id ANTES del '(' y emite ERA con el nombre,
//   manteniendo el contador de la llamada en la pila de SemanticContext.
//   LALR(1) distingue id→AsignLhs vs id→CallStmtHead por lookahead (= vs ().

CallStmt: () = {
    CallStmtHead "(" CallArgs ")" ";" => { ctx.gen_gosub_stmt(); }
};

CallStmtHead: () = {
    <name:"id"> => { ctx.gen_era(name); }
};

// Lista de argumentos de una llamada. Cada CallArg emite PARAM al terminar.
CallArgs: () = {
    CallArg CallArgsTail => (),
                         => (),
};

CallArg: () = {
    Expresion => { ctx.gen_param(); }
};

CallArgsTail: () = {
    "," CallArg CallArgsTail => (),
                             => (),
};

// ── §4.9  Condicional ─────────────────────────────────────────────────────────
//
//   "si" "(" Expresion ")"           ← evalúa cond, deja operando en pila
//   CondGotoF                        ← pop cond, valida Entero, emite GOTOF pendiente
//   Cuerpo                           ← cuerpo del si
//   SinoOpc                          ← si hay sino: emite GOTO y rellena GOTOF
//   CondEnd                          ← rellena el salto que quedó pendiente
//   ";"

Condicion: () = {
    "si" "(" Expresion ")" CondGotoF Cuerpo SinoOpc CondEnd ";" => ()
};

CondGotoF: () = { => { ctx.gen_gotof_if(); } };

CondEnd:   () = { => { ctx.end_if(); } };

SinoOpc: () = {
    "sino" SinoStart Cuerpo => (),
                            => (),
};

SinoStart: () = { => { ctx.gen_else_goto(); } };

// ── §4.10  Ciclo ──────────────────────────────────────────────────────────────
//
//   "mientras"                       ← antes de '(': marca punto de retorno
//   CicloStart
//   "(" Expresion ")"                ← evalúa cond
//   CicloAfterCond                   ← pop cond, valida, emite GOTOF pendiente
//   "haz" Cuerpo                     ← cuerpo del while
//   CicloEnd                         ← emite GOTO al inicio, rellena GOTOF
//   ";"

Ciclo: () = {
    "mientras" CicloStart "(" Expresion ")" CicloAfterCond "haz" Cuerpo CicloEnd ";" => ()
};

CicloStart:     () = { => { ctx.push_return_point(); } };
CicloAfterCond: () = { => { ctx.gen_gotof_while(); } };
CicloEnd:       () = { => { ctx.end_while(); } };

// ── §4.11  Impresión ──────────────────────────────────────────────────────────

Imprime: () = {
    "escribe" "(" ElemImprime ColaImprime ")" ";" => ()
};

ElemImprime: () = {
    Expresion          => { ctx.emit_print_expr(); },
    <s:"letrero">      => { ctx.emit_print_str(s); },
};

ColaImprime: () = {
    "," ElemImprime ColaImprime => (),
                                => (),
};

// ── §4.12  Regresa ────────────────────────────────────────────────────────────

Regresa: () = {
    "regresa" "(" Expresion ")" ";" => { ctx.emit_return(); }
};

// ── §4.13  Expresiones ────────────────────────────────────────────────────────

Expresion: () = {
    Exp ColaExpresionRel => ()
};

ColaExpresionRel: () = {
    OpLogico Exp => (),
                 => (),
};

OpLogico: () = {
    ">"  => { ctx.push_operator(Op::Gt); },
    "<"  => { ctx.push_operator(Op::Lt); },
    "!=" => { ctx.push_operator(Op::Ne); },
    "==" => { ctx.push_operator(Op::Eq); },
};

Exp: () = {
    Termino TerminoAdd => ()
};

TerminoAdd: () = {
    OpAdd Termino TerminoAdd => (),
                             => (),
};

OpAdd: () = {
    "+" => { ctx.push_operator(Op::Add); },
    "-" => { ctx.push_operator(Op::Sub); },
};

Termino: () = {
    Factor FactorMult => ()
};

FactorMult: () = {
    OpMult Factor FactorMult => (),
                             => (),
};

OpMult: () = {
    "*" => { ctx.push_operator(Op::Mul); },
    "/" => { ctx.push_operator(Op::Div); },
};

// ── §4.14  Factor ─────────────────────────────────────────────────────────────
//
// Tres casos (signo unario y llamadas-como-factor se aplazan a Entrega 4):
//   · "(" Expresion ")"  — paréntesis de agrupación, fondo falso
//   · FactorAtomId       — id solo: empuja como operando (resuelve tipo)
//   · FactorAtomCall     — id(...) como factor: aceptado sintácticamente, sin
//                          cuádruplos en esta entrega
//   · Cte                — constante literal

Factor: () = {
    "(" FactorLParen Expresion ")" FactorRParen => (),
    FactorAtomId                                => (),
    FactorAtomCall                              => (),
    Cte                                         => (),
};

FactorLParen: () = { => { ctx.push_lparen(); } };
FactorRParen: () = { => { ctx.pop_lparen(); } };

FactorAtomId: () = {
    <id:"id"> => { ctx.push_id_operand(id); }
};

FactorAtomCall: () = {
    FactorCallHead "(" CallArgs ")" => { ctx.gen_gosub_factor(); }
};

FactorCallHead: () = {
    <name:"id"> => { ctx.gen_era(name); }
};

// ── §4.15  Constantes ─────────────────────────────────────────────────────────

Cte: () = {
    <v:"cte_ent">  => { ctx.push_const_int(v); },
    <v:"cte_flot"> => { ctx.push_const_float(v); },
};
